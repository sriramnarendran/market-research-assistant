# =============================================================================
# Azure OpenAI — single provider for both the main pipeline and the judge.
# Point MAIN and JUDGE at different deployments (e.g. main=gpt-5, judge=gpt-5-mini)
# to recover model-family independence for the judge. Defaulting to the same
# deployment is fine for a single-model setup.
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_MAIN_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-5-mini

# =============================================================================
# Tavily — web search inside the research agent's `search` tool
# =============================================================================
TAVILY_API_KEY=

# Web search publish window in days (default 90 ≈ 3 months). Set 0 to use TAVILY_TIME_RANGE instead.
TAVILY_SEARCH_DAYS=90
# Optional fallback when TAVILY_SEARCH_DAYS=0: day | week | month | year
# TAVILY_TIME_RANGE=month

# =============================================================================
# Database — Supabase (production) or local Postgres (docker-compose)
# =============================================================================
# Supabase: Project Settings → Database → Connection string
#
# **Azure Container Apps / any IPv4-only host:** use the **Session pooler** URI
# (host aws-0-<region>.pooler.supabase.com, port 5432). Do NOT use db.<ref>.supabase.co
# — that direct host is IPv6-only and fails with "Network is unreachable".
#
# Example pooler URL (postgresql:// is normalized to postgresql+asyncpg:// at startup).
# URL-encode special password characters: [ → %5B, ] → %5D, @ → %40
# DATABASE_URL=postgresql://postgres.[project-ref]:%5BYOUR-PASSWORD%5D@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Local docker-compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_research

# =============================================================================
# App
# =============================================================================
# "live" hits real Azure endpoints; "test" uses Pydantic AI TestModel and no network
LLM_MODE=live

# Per-run hard cap on total tokens across all phases (extract + agent + synth + judge)
PER_RUN_TOKEN_BUDGET=200000

# Tokens reserved for the judge phase (extract/synth cannot spend below limit - reserve)
JUDGE_BUDGET_RESERVE=50000

# Pipeline concurrency caps. The pipeline runs HTTP fetches and per-source
# LLM extract calls in parallel under these semaphores. Raise if your Azure
# deployment has lots of TPM headroom; lower if you hit rate limits.
FETCH_CONCURRENCY=5
EXTRACT_CONCURRENCY=5
JUDGE_CONCURRENCY=5
# One asyncio task per user keyword during the research phase (max 3 topics).
RESEARCH_CONCURRENCY=3

# User URL fetch — slow IR/news sites may need longer read timeouts + retries
FETCH_CONNECT_TIMEOUT=20
FETCH_READ_TIMEOUT=45
FETCH_MAX_RETRIES=2
FETCH_RETRY_BACKOFF_SECONDS=1.5

# Max sources that run LLM extract per run (user URLs first, then top Tavily scores)
MAX_EXTRACT_SOURCES=8
# Max facts kept per source after extraction
MAX_FACTS_PER_SOURCE=12

# Auth (Phase 2)
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_TTL_HOURS=24
AUTH_DEV_BYPASS=true
AUTH_COOKIE_SECURE=false

# CORS — comma-separated allowed origins for the frontend
CORS_ALLOW_ORIGINS=http://localhost:5173

# Dev-only: when LLM_MODE=test or no JWT is present, treat requests as this user id
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Logging
LOG_LEVEL=INFO

# Per-LLM-call transcript log (one JSON line per agent.run()). Set to ""
# (empty) to disable. Rotated when it reaches LLM_LOG_MAX_BYTES.
LLM_LOG_FILE=logs/llm_requests.jsonl
LLM_LOG_MAX_BYTES=50000000
LLM_LOG_BACKUP_COUNT=5
